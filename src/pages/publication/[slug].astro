---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentLayout from "../../components/ContentLayout.astro";

export async function getStaticPaths() {
  const publications = await getCollection("publications");
  return publications.map((publication) => ({
    params: { slug: publication.data.slug },
    props: { publication }
  }));
}

const { publication } = Astro.props;
const { Content } = await render(publication);
const { data } = publication;
---

<BaseLayout title={data.title}>
  <main class="page-main shell">
    <ContentLayout>
      <div class="article-layout article-layout--single">
        <article class="article-content">
          <header class="article-header">
            <h1>{data.title}</h1>
            <div class="article-meta">
              <p>Published in <em>{data.venue}</em>, {data.date.getFullYear()}.</p>
              <p>Recommended citation: {data.citation}</p>
            </div>
            {data.paperUrl && <div class="article-actions"><a class="text-link" href={data.paperUrl} target="_blank" rel="noreferrer">Download Paper</a></div>}
          </header>
          <div class="prose"><Content /></div>
        </article>
      </div>
    </ContentLayout>
  </main>
</BaseLayout>
