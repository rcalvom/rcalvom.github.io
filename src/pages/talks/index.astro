---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";
import ContentLayout from "../../components/ContentLayout.astro";
import TalkCard from "../../components/TalkCard.astro";
import { getTalks } from "../../lib/content";

const talks = await getTalks();
---

<BaseLayout title="Talks and presentations" description={`Conference talks and poster presentations by ${site.name}.`}>
  <main id="main-content" class="page-main shell">
    <ContentLayout>
      <header class="page-heading">
        <div>
          <h1>Talks and presentations</h1>
        </div>
      </header>
      <section class="section">
        <div class="talk-list">
          {talks.map((talk) => <TalkCard talk={talk} />)}
        </div>
      </section>
    </ContentLayout>
  </main>
</BaseLayout>
