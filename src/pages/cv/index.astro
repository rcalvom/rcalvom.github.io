---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentLayout from "../../components/ContentLayout.astro";
import { site } from "../../config/site";

const cv = await getEntry("pages", "cv");
if (!cv) {
  throw new Error("CV content entry is missing.");
}
const { Content } = await render(cv);
---

<BaseLayout title="CV" description={`Curriculum vitae of ${site.name}, PhD student in Electrical and Computer Engineering at Purdue University.`}>
  <main id="main-content" class="page-main shell">
    <ContentLayout>
      <header class="page-heading cv-page-heading">
        <div>
          <h1>CV</h1>
        </div>
        <div class="cv-download">
          <div class="cv-download__actions">
            <a class="button-link" href={site.cv} target="_blank" rel="noreferrer">Academic CV (PDF)</a>
            <a class="button-link" href={site.resume} target="_blank" rel="noreferrer">Résumé (PDF)</a>
          </div>
        </div>
      </header>
      <article class="prose cv-content">
        <Content />
      </article>
    </ContentLayout>
  </main>
</BaseLayout>
