---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentLayout from "../../components/ContentLayout.astro";

const cv = await getEntry("pages", "cv");
if (!cv) {
  throw new Error("CV content entry is missing.");
}
const { Content } = await render(cv);
---

<BaseLayout title="CV">
  <main class="page-main shell">
    <ContentLayout>
      <header class="page-heading cv-page-heading">
        <div>
          <h1>CV</h1>
        </div>
        <div class="cv-download">
          <div class="cv-download__actions">
            <a class="button-link button-link--quiet" href="/cv.pdf" target="_blank" rel="noreferrer">View CV as PDF</a>
            <a class="button-link" href="/cv.pdf" download="Ricardo-Calvo-Mendez-CV.pdf">Download CV as PDF</a>
          </div>
        </div>
      </header>
      <article class="prose cv-content">
        <Content />
      </article>
    </ContentLayout>
  </main>
</BaseLayout>
