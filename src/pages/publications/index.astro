---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentLayout from "../../components/ContentLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import { getPublications } from "../../lib/content";

const publications = await getPublications();
const refereedPublications = publications.filter((publication) => publication.data.category === "refereed-conference-publications");
const otherWorks = publications.filter((publication) => publication.data.category === "other-works");
---

<BaseLayout title="Publications">
  <main class="page-main shell">
    <ContentLayout>
      <header class="page-heading">
        <div>
          <h1>Publications</h1>
        </div>
      </header>
      <section class="section archive-intro">
        <p>You can also find my articles on <a href="https://scholar.google.com/citations?user=JwpDnSIAAAAJ&hl=es&authuser=1">my Google Scholar profile</a>.</p>
        <div class="section-heading"><h2>Refereed Conference Publications</h2></div>
        <div class="publication-list">
          {refereedPublications.map((publication) => <PublicationCard publication={publication} />)}
        </div>
        {otherWorks.length > 0 && (
          <>
            <div class="section-heading"><h2>Other works</h2></div>
            <div class="publication-list">
              {otherWorks.map((publication) => <PublicationCard publication={publication} />)}
            </div>
          </>
        )}
      </section>
    </ContentLayout>
  </main>
</BaseLayout>
