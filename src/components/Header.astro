---
import ThemeToggle from "./ThemeToggle.astro";
import { site, visibleNavigation } from "../config/site";

const pathname = Astro.url.pathname;
const navigation = visibleNavigation();
const isActive = (href: string) => {
  if (href === "/publications/") return pathname.startsWith("/publications/") || pathname.startsWith("/publication/");
  if (href === "/year-archive/") return pathname.startsWith("/year-archive/") || pathname.startsWith("/posts/");
  return pathname.startsWith(href);
};
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="wordmark" href="/" aria-label={`${site.name} home`}>
      <span class="wordmark__name">{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a class:list={["nav-link", { "nav-link--active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
      <ThemeToggle />
    </nav>

    <details class="mobile-nav">
      <summary data-navigation-toggle aria-label="Open navigation"><span></span><span></span></summary>
      <div class="mobile-nav__panel">
        {navigation.map((item) => (
          <a class:list={["mobile-nav__link", { "mobile-nav__link--active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))}
        <ThemeToggle />
      </div>
    </details>
  </div>
</header>

<script>
  for (const navigation of document.querySelectorAll<HTMLDetailsElement>(".mobile-nav")) {
    const toggle = navigation.querySelector<HTMLElement>("[data-navigation-toggle]");
    navigation.addEventListener("toggle", () => {
      toggle?.setAttribute("aria-label", navigation.open ? "Close navigation" : "Open navigation");
    });
  }
</script>
