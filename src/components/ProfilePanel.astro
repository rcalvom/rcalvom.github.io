---
import { Image } from "astro:assets";
import portrait from "../assets/profile/ricardo.jpg";
import { site } from "../config/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={["profile-panel", { "profile-panel--compact": compact }]}>
  <Image class="profile-panel__image" src={portrait} alt="Portrait of Ricardo Calvo Mendez" widths={[240, 480, 720]} sizes="(max-width: 760px) 120px, (max-width: 960px) 180px, 260px" />
  <div class="profile-panel__content">
    <h2>{site.name}</h2>
    <p class="profile-panel__bio">{site.role}</p>
    <ul class="profile-panel__meta">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z" /><circle cx="12" cy="10" r="2" /></svg>
        {site.location}
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V9h14v12M3 9h18L12 3 3 9Zm5 4h2m4 0h2m-8 4h2m4 0h2" /></svg>
        {site.institution}
      </li>
    </ul>
    <nav class="profile-panel__links" aria-label="External profiles">
      <a href={`mailto:${site.email}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m4 7 8 6 8-6" /></svg>
        <span>Email</span>
      </a>
      <a href={site.links.scholar}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m2 10 10-5 10 5-10 5L2 10Z" /><path d="M6 12v4c2.4 2 9.6 2 12 0v-4M20 11v5" /></svg>
        <span>Google Scholar</span>
      </a>
      <a href={site.links.orcid}>
        <span class="profile-panel__brand-icon" aria-hidden="true">iD</span>
        <span>ORCID</span>
      </a>
      <a href={site.links.github}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.5 1.5-4.5-2.5-6.3-3m12.6 6v-3.9c0-1.1.1-1.6-.5-2.3 2.1-.2 4.3-1 4.3-4.7 0-1.1-.4-2-1.1-2.7.1-.3.5-1.3-.1-2.7 0 0-.9-.3-2.8 1.1A9.6 9.6 0 0 0 10 6.8c-1.9-1.4-2.8-1.1-2.8-1.1-.6 1.4-.2 2.4-.1 2.7A3.9 3.9 0 0 0 6 11.1c0 3.7 2.2 4.5 4.3 4.7-.5.5-.5 1.3-.5 2.3V22" /></svg>
        <span>GitHub</span>
      </a>
      <a href={site.links.linkedin}>
        <span class="profile-panel__brand-icon" aria-hidden="true">in</span>
        <span>LinkedIn</span>
      </a>
    </nav>
  </div>
</aside>
